<<<
EARS_PATTERN: Ubiquitous
PRODUCT: Ansible, Salt, QubesadminTools, Terraform
RELATIONS:
- TYPE: Parent
  VALUE: L1-IDEMPOTENT
  ROLE: Refines
- TYPE: File
  ROLE: Authority
  PATH: qubes-core-admin/qubes/api/admin.py
  ELEMENT: function
